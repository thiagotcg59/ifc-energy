# Copie este arquivo para ".env" e ajuste se precisar.
# O arquivo ".env" NUNCA vai para o GitHub (está no .gitignore).
# Todos os valores abaixo são os padrões: sem ".env" o sistema já funciona.

# Pasta onde o EnergyPlus foi descompactado/instalado
IFC_ENERGY_ENERGYPLUS_DIR=C:\EnergyPlusV26-2-0

# Pasta de dados locais (uploads, execuções, banco SQLite)
IFC_ENERGY_DADOS_DIR=dados

# Pasta com os arquivos climáticos EPW
IFC_ENERGY_CLIMA_DIR=dados\clima

# Nível de detalhe dos registros (DEBUG, INFO, WARNING, ERROR)
IFC_ENERGY_NIVEL_LOG=INFO
