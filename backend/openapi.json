{
  "openapi": "3.1.0",
  "info": {
    "title": "ifc-energy",
    "description": "Simulação termoenergética de casas unifamiliares a partir de IFC.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/saude": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Estado do sistema",
        "operationId": "saude_api_v1_saude_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulacoes/exemplo": {
      "post": {
        "tags": [
          "simulações"
        ],
        "summary": "Coloca na fila a simulação da casa de exemplo",
        "operationId": "simular_exemplo_api_v1_simulacoes_exemplo_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Simulacao"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulacoes": {
      "get": {
        "tags": [
          "simulações"
        ],
        "summary": "Últimas simulações, da mais recente para a mais antiga",
        "operationId": "listar_simulacoes_api_v1_simulacoes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Simulacao"
                  },
                  "type": "array",
                  "title": "Response Listar Simulacoes Api V1 Simulacoes Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulacoes/{sim_id}": {
      "get": {
        "tags": [
          "simulações"
        ],
        "summary": "Estado de uma simulação",
        "operationId": "estado_da_simulacao_api_v1_simulacoes__sim_id__get",
        "parameters": [
          {
            "name": "sim_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sim Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Simulacao"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulacoes/{sim_id}/resultados": {
      "get": {
        "tags": [
          "simulações"
        ],
        "summary": "Consumo anual por uso final",
        "operationId": "resultados_da_simulacao_api_v1_simulacoes__sim_id__resultados_get",
        "parameters": [
          {
            "name": "sim_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sim Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumoAnual"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumoAnual": {
        "properties": {
          "itens": {
            "items": {
              "$ref": "#/components/schemas/ItemConsumo"
            },
            "type": "array",
            "title": "Itens"
          },
          "total_por_fonte": {
            "items": {
              "$ref": "#/components/schemas/TotalPorFonte"
            },
            "type": "array",
            "title": "Total Por Fonte"
          },
          "total_kwh": {
            "type": "number",
            "title": "Total Kwh"
          },
          "area_condicionada_m2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area Condicionada M2"
          },
          "area_total_m2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area Total M2"
          },
          "intensidade_kwh_m2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intensidade Kwh M2"
          }
        },
        "type": "object",
        "required": [
          "itens",
          "total_por_fonte",
          "total_kwh",
          "area_condicionada_m2",
          "area_total_m2",
          "intensidade_kwh_m2"
        ],
        "title": "ConsumoAnual",
        "description": "Consumo anual por uso final e fonte de energia, em kWh."
      },
      "Erro": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Erro"
      },
      "EstadoEnergyPlus": {
        "properties": {
          "encontrado": {
            "type": "boolean",
            "title": "Encontrado"
          },
          "versao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Versao"
          },
          "versao_esperada": {
            "type": "string",
            "title": "Versao Esperada"
          },
          "pasta": {
            "type": "string",
            "title": "Pasta"
          },
          "mensagem": {
            "type": "string",
            "title": "Mensagem"
          }
        },
        "type": "object",
        "required": [
          "encontrado",
          "versao",
          "versao_esperada",
          "pasta",
          "mensagem"
        ],
        "title": "EstadoEnergyPlus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemConsumo": {
        "properties": {
          "uso_final": {
            "type": "string",
            "title": "Uso Final"
          },
          "uso_final_chave": {
            "type": "string",
            "title": "Uso Final Chave"
          },
          "fonte": {
            "type": "string",
            "title": "Fonte"
          },
          "fonte_chave": {
            "type": "string",
            "title": "Fonte Chave"
          },
          "kwh": {
            "type": "number",
            "title": "Kwh"
          }
        },
        "type": "object",
        "required": [
          "uso_final",
          "uso_final_chave",
          "fonte",
          "fonte_chave",
          "kwh"
        ],
        "title": "ItemConsumo"
      },
      "Saude": {
        "properties": {
          "estado": {
            "type": "string",
            "const": "ok",
            "title": "Estado"
          },
          "versao": {
            "type": "string",
            "title": "Versao"
          },
          "energyplus": {
            "$ref": "#/components/schemas/EstadoEnergyPlus"
          }
        },
        "type": "object",
        "required": [
          "estado",
          "versao",
          "energyplus"
        ],
        "title": "Saude"
      },
      "Simulacao": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "estado": {
            "type": "string",
            "enum": [
              "na_fila",
              "validando",
              "dias_de_projeto",
              "anual",
              "concluida",
              "falhou"
            ],
            "title": "Estado"
          },
          "mensagem": {
            "type": "string",
            "title": "Mensagem"
          },
          "detalhes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Detalhes"
          },
          "criado_em": {
            "type": "string",
            "title": "Criado Em"
          },
          "atualizado_em": {
            "type": "string",
            "title": "Atualizado Em"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tipo",
          "estado",
          "mensagem",
          "detalhes",
          "criado_em",
          "atualizado_em"
        ],
        "title": "Simulacao"
      },
      "TotalPorFonte": {
        "properties": {
          "fonte": {
            "type": "string",
            "title": "Fonte"
          },
          "fonte_chave": {
            "type": "string",
            "title": "Fonte Chave"
          },
          "kwh": {
            "type": "number",
            "title": "Kwh"
          }
        },
        "type": "object",
        "required": [
          "fonte",
          "fonte_chave",
          "kwh"
        ],
        "title": "TotalPorFonte"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
