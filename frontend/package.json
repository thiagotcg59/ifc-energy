{
  "name": "ifc-energy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copiar-demo.mjs && vite",
    "build": "node scripts/copiar-demo.mjs && tsc --noEmit && vite build",
    "build:demo": "node scripts/copiar-demo.mjs && tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "tipos": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "formatar": "prettier --write .",
    "gerar-tipos": "openapi-typescript ../backend/openapi.json -o src/api/tipos.gerado.ts && prettier --write src/api/tipos.gerado.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
